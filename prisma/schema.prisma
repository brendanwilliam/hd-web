generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String      @id @default(cuid())
  githubId  String      @unique
  login     String
  avatarUrl String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  grants    DeviceGrant[]
  tokens    ApiToken[]
  reports   Report[]
  riotMatches RiotMatch[]
}

model DeviceGrant {
  id             String    @id @default(cuid())
  deviceCodeHash String    @unique
  userCode       String    @unique
  clientName     String
  expiresAt      DateTime
  approvedAt     DateTime?
  consumedAt     DateTime?
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  token          ApiToken?
  createdAt      DateTime  @default(now())
  @@index([expiresAt])
  @@index([accountId])
}

model ApiToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  scope      String       @default("reports:write")
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grantId    String?      @unique
  grant      DeviceGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  @@index([accountId, revokedAt])
}

model Report {
  id                    String   @id
  accountId             String
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payloadHash           String
  payload               Json
  riotIdGameName        String
  riotIdTagLine         String
  observedStartedAt     DateTime
  durationMs            Int
  gameMode              String
  mapNumber             Int
  resolvedPuuid         String?
  riotRegion            String?
  matchId               String?
  riotGameId            String?
  participantId         Int?
  reconciliationState   String   @default("pending")
  reconciliationAttempt Int      @default(0)
  retryAt               DateTime?
  reconciliationError   String?
  matchSummary          Json?
  riotEvents            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([accountId, id])
  @@index([accountId, observedStartedAt])
  @@index([reconciliationState, retryAt])
}

model RiotMatch {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  matchId          String
  riotGameId       String?
  riotIdGameName   String
  riotIdTagLine    String
  riotRegion       String
  gameStartedAt    DateTime
  gameMode         String
  durationMs       Int
  matchSummary     Json
  riotEvents       Json?
  fetchedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  @@unique([accountId, matchId])
  @@index([accountId, gameStartedAt])
}
